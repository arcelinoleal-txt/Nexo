{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "env": {
      "NEXO_PUBLIC_URL": "https://nexo-production-0b47.up.railway.app",
      "NEXO_PORTA": "3000"
    }
  },
  "deploy": {
    "startCommand": "node servidor/servidor.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "env": {
      "NEXO_PUBLIC_URL": "https://nexo-production-0b47.up.railway.app",
      "NEXO_PORTA": "3000"
    }
  }
}