# ==============================================================
   .env.example - Discord Clone Backend
   ==============================================================

   # Porta do Servidor
   PORT=3001

   # Segurança
   JWT_SECRET=discord_clone_dev_secret_key_mude_para_producao
   
   # Banco de Dados (PostgreSQL - Railway/Render)
   # Exemplos:
   # Railway: postgres://username:password@hostname:5432/databasename
   # Render: postgresql://user:pass@host:port/db
   DATABASE_URL=postgresql://postgres:password@localhost:5432/discord_clone
   
   # URL do Servidor para o Frontend (React)
   # Use esta URL para configurar o VITE_SERVER_URL no frontend
   VITE_SERVER_URL=http://localhost:3001

   # Ambiente
   NODE_ENV=development