# ===================================================================
# Nexo - Variáveis de Ambiente para Produção (Railway, Render, VPS)
# ===================================================================
# Copie este arquivo para .env e preencha os valores
# No Railway: adicione cada variável na aba "Variables" do projeto

# -------------------------------------------------------------------
# OBRIGATÓRIAS
# -------------------------------------------------------------------

# Porta que o Railway atribui automaticamente (não defina manualmente no Railway)
# PORT=3000

# Segredo para assinar tokens de sessão (gere um aleatório: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXO_SEGREDO_TOKEN=sua_chave_secreta_aqui_32_bytes_hex

# Diretório persistente para dados (contas, uploads)
# No Railway: crie um Volume e monte em /data, depois defina:
# NEXO_DIR_DADOS=/data

# -------------------------------------------------------------------
# E-MAIL (OPCIONAL - para recuperação de senha via e-mail)
# -------------------------------------------------------------------
# Se não configurado, códigos de recuperação aparecem no console (modo dev)
# NEXO_SMTP_HOST=smtp.seuprovedor.com
# NEXO_SMTP_PORT=587
# NEXO_SMTP_USER=seu_usuario
# NEXO_SMTP_PASS=sua_senha
# NEXO_EMAIL_DE="Nexo <nao-responda@seudominio.com>"

# -------------------------------------------------------------------
# OPCIONAIS
# -------------------------------------------------------------------

# Porta alternativa (se não quiser usar PORT do Railway)
# NEXO_PORTA=3000

# Limite de upload em bytes (padrão: 25MB)
# NEXO_MAX_ARQUIVO=26214400

# Log level (debug, info, warn, error)
# NEXO_LOG_LEVEL=info